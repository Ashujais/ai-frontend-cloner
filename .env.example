# AI Provider Configuration
# Supported options: 'gemini', 'openai', 'anthropic', 'ollama', or 'smart_engine' (local heuristic AI)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# API Keys (Provide the one corresponding to your chosen LLM_PROVIDER)
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local Ollama URL (if using LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Application Configuration
PORT=3000
MAX_REPAIR_ATTEMPTS=3
REQUEST_TIMEOUT=15000
WORKSPACE_DIR=workspace/generated
